---
/**
 * Header.astro — Override Starlight
 * Fidèle à la maquette Home.dc.html :
 *   logo SVG + wordmark | nav : Tools · Documentation · GitHub ↗
 */
import LanguageSelect from "@astrojs/starlight/components/LanguageSelect.astro";

const hasSidebar = Astro.locals.starlightRoute.hasSidebar;
const locale = Astro.currentLocale || "en";
---

<header class="bo-header">
  <div class="bo-header__inner">

    <!-- Logo + wordmark -->
    <a href={`/${locale === "en" ? "" : locale}`} class="bo-header__brand" aria-label="BananaOps — retour à l'accueil">
      <svg viewBox="0 0 160 160" width="40" height="40" role="img" aria-label="BananaOps logo" aria-hidden="true">
        <rect width="160" height="160" rx="38" fill="#10264A"/>
        <g transform="translate(28,22) scale(1.12)">
          <path d="M 28.5 9.5 C 28 3, 33 0.5, 37.5 2.5 L 40.5 8 C 37 6.5, 33 6.5, 28.5 9.5 Z" fill="#8A6A2E"/>
          <path d="M 26 14 C 8 46, 14 84, 50 93 C 72 98, 94 90, 91 79 C 88 69, 72 78, 58 72 C 40 64, 34 42, 42 18 C 45 8, 29 6, 26 14 Z" fill="#FFC83D"/>
          <circle cx="24" cy="45" r="3.6" fill="#10264A"/>
          <circle cx="35.5" cy="48" r="3.6" fill="#10264A"/>
          <path d="M 24.5 56.5 q 6 7.5 12.5 1.5" fill="none" stroke="#10264A" stroke-width="3.4" stroke-linecap="round"/>
        </g>
      </svg>
      <span class="bo-header__wordmark">
        <span class="bo-header__wordmark-bold">banana</span><span class="bo-header__wordmark-light">ops</span>
      </span>
    </a>

    <!-- Navigation desktop -->
    <nav class="bo-header__nav" aria-label="Navigation principale">
      <a href="#tools" class="bo-header__link">Tools</a>
      <a href="https://docs.bananaops.tech" class="bo-header__link">Documentation</a>
      <a href="https://github.com/BananaOps" class="bo-header__link bo-header__link--ext" target="_blank" rel="noopener noreferrer">GitHub ↗</a>

      {!hasSidebar && <LanguageSelect />}
    </nav>

    <!-- Hamburger mobile -->
    <button
      type="button"
      class="bo-header__hamburger"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="bo-mobile-menu"
      id="bo-hamburger"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Menu mobile (masqué par défaut) -->
  <div class="bo-mobile-menu" id="bo-mobile-menu" aria-hidden="true">
    <nav aria-label="Navigation mobile">
      <a href="#tools" class="bo-mobile-menu__link">Tools</a>
      <a href="https://docs.bananaops.tech" class="bo-mobile-menu__link">Documentation</a>
      <a href="https://github.com/BananaOps" class="bo-mobile-menu__link bo-mobile-menu__link--ext" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </nav>
  </div>
</header>

<style>
  /* ─── Header ────────────────────────────────────────────────────────────── */
  .bo-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--cream);
    border-bottom: 1px solid rgba(16, 38, 74, 0.10);
    width: 100%;
  }

  .bo-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 96px;
    max-width: 1440px;
    margin: 0 auto;
  }

  /* ─── Brand ──────────────────────────────────────────────────────────────── */
  .bo-header__brand {
    display: flex;
    align-items: center;
    gap: 14px;
    text-decoration: none;
    flex-shrink: 0;
  }
  .bo-header__wordmark {
    font-family: var(--font-display);
    font-size: 26px;
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }
  .bo-header__wordmark-bold {
    font-weight: 800;
    color: var(--midnight);
  }
  .bo-header__wordmark-light {
    font-weight: 500;
    color: var(--cloud);
  }

  /* ─── Nav desktop ────────────────────────────────────────────────────────── */
  .bo-header__nav {
    display: flex;
    align-items: center;
    gap: 36px;
  }
  .bo-header__link {
    font-size: 15px;
    font-weight: 500;
    color: var(--midnight);
    text-decoration: none;
    transition: color 0.2s;
  }
  .bo-header__link:hover {
    color: #2E5288;
  }
  .bo-header__link--ext {
    color: var(--cloud);
  }
  .bo-header__link--ext:hover {
    color: var(--midnight);
  }
  /* ─── Hamburger ──────────────────────────────────────────────────────────── */
  .bo-header__hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .bo-header__hamburger span {
    display: block;
    height: 2px;
    background: var(--midnight);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .bo-header__hamburger span:last-child {
    width: 70%;
    background: var(--cloud);
  }
  .bo-header__hamburger[aria-expanded="true"] span:first-child {
    transform: translateY(7px) rotate(45deg);
  }
  .bo-header__hamburger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .bo-header__hamburger[aria-expanded="true"] span:last-child {
    width: 100%;
    background: var(--midnight);
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile menu ────────────────────────────────────────────────────────── */
  .bo-mobile-menu {
    display: none;
    flex-direction: column;
    padding: 12px 20px 20px;
    border-top: 1px solid rgba(16, 38, 74, 0.08);
    background: var(--cream);
  }
  .bo-mobile-menu[aria-hidden="false"] {
    display: flex;
  }
  .bo-mobile-menu nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .bo-mobile-menu__link {
    font-size: 16px;
    font-weight: 500;
    color: var(--midnight);
    text-decoration: none;
    padding: 10px 4px;
    border-bottom: 1px solid rgba(16, 38, 74, 0.06);
    transition: color 0.2s;
  }
  .bo-mobile-menu__link:last-child {
    border-bottom: none;
  }
  .bo-mobile-menu__link:hover {
    color: var(--cloud);
  }
  .bo-mobile-menu__link--ext {
    color: var(--cloud);
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .bo-header__inner {
      padding: 16px 40px;
    }
  }

  @media (max-width: 768px) {
    .bo-header__inner {
      padding: 14px 20px;
    }
    .bo-header__nav {
      display: none;
    }
    .bo-header__hamburger {
      display: flex;
    }
    .bo-header__wordmark {
      font-size: 21px;
    }
    svg[aria-label="BananaOps logo"] {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  const hamburger = document.getElementById("bo-hamburger") as HTMLButtonElement | null;
  const mobileMenu = document.getElementById("bo-mobile-menu") as HTMLElement | null;

  hamburger?.addEventListener("click", () => {
    const expanded = hamburger.getAttribute("aria-expanded") === "true";
    hamburger.setAttribute("aria-expanded", String(!expanded));
    if (mobileMenu) {
      mobileMenu.setAttribute("aria-hidden", String(expanded));
    }
  });

  // Fermer le menu quand on clique sur un lien
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      hamburger?.setAttribute("aria-expanded", "false");
      mobileMenu.setAttribute("aria-hidden", "true");
    });
  });
</script>
