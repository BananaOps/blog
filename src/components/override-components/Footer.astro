---
/**
 * Footer.astro — Override Starlight
 * Fidèle à la maquette Home.dc.html :
 *   © 2026 BananaOps  |  GitHub · Contact · Privacy · Terms
 */
---

<footer class="bo-footer">
  <span class="bo-footer__copy">© 2026 BananaOps</span>
  <nav aria-label="Footer links">
    <a href="https://github.com/BananaOps" target="_blank" rel="noopener noreferrer">GitHub</a>
    <a href="mailto:hello@bananaops.tech">Contact</a>
    <a href="/privacy-policy/">Privacy</a>
    <a href="/terms-conditions/">Terms</a>
  </nav>
</footer>

<style>
  .bo-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 32px 96px 36px;
    border-top: 1px solid rgba(16, 38, 74, 0.12);
    background: var(--cream);
    font-family: var(--font-body);
  }

  .bo-footer__copy {
    font-size: 14px;
    color: var(--cloud);
  }

  .bo-footer nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .bo-footer nav a {
    font-size: 14px;
    font-weight: 500;
    color: var(--midnight);
    text-decoration: none;
    transition: color 0.2s;
  }

  .bo-footer nav a:hover {
    color: #2E5288;
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .bo-footer {
      padding: 28px 40px;
    }
  }

  @media (max-width: 768px) {
    .bo-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 24px 20px 28px;
    }

    /* Sur mobile la maquette met la nav en premier, le copyright en bas */
    .bo-footer {
      flex-direction: column-reverse;
    }

    .bo-footer nav {
      flex-wrap: wrap;
      gap: 20px;
    }
  }
</style>
