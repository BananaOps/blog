---
/**
 * HomePage.astro — Page d'accueil BananaOps
 * Contient hero + tools grid + who we are
 * Fidèle à la maquette Home.dc.html
 */
import ToolCard from './ToolCard.astro';
---

<div class="bo-home">

  <!-- Hero -->
  <section id="top" class="bo-hero">
    <div class="bo-hero__content">
      <span class="bo-hero__eyebrow">Open-source platform tooling</span>
      <h1 class="bo-hero__title">Let's make DevOps simpler, practical and energizing.</h1>
      <p class="bo-hero__sub">
        Four Go tools for people who run platforms: deployment tracking, EC2 night shutdown,
        chart registry sync and a generated cluster dashboard.
        Documentation lives here, next to the source.
      </p>
      <div class="bo-hero__cta">
        <a href="#tools" class="bo-btn-primary">Browse the tools</a>
        <a href="https://docs.bananaops.tech" class="bo-btn-outline">Read the docs</a>
      </div>
    </div>
    <svg
      viewBox="0 0 110 105"
      width="360"
      height="344"
      role="img"
      aria-label="BananaOps mascot"
      class="bo-hero__mascot"
    >
      <g transform="translate(3,3)">
        <path
          d="M 28.5 9.5 C 28 3, 33 0.5, 37.5 2.5 L 40.5 8 C 37 6.5, 33 6.5, 28.5 9.5 Z"
          fill="#8A6A2E"
        />
        <path
          d="M 26 14 C 8 46, 14 84, 50 93 C 72 98, 94 90, 91 79 C 88 69, 72 78, 58 72 C 40 64, 34 42, 42 18 C 45 8, 29 6, 26 14 Z"
          fill="#FFC83D"
        />
        <circle cx="24" cy="45" r="3.6" fill="#10264A" />
        <circle cx="35.5" cy="48" r="3.6" fill="#10264A" />
        <path
          d="M 24.5 56.5 q 6 7.5 12.5 1.5"
          fill="none"
          stroke="#10264A"
          stroke-width="3.4"
          stroke-linecap="round"
        />
      </g>
    </svg>
  </section>

  <!-- Tools -->
  <section id="tools" class="bo-tools">
    <div class="bo-tools__header">
      <h2 class="bo-tools__title">Tools</h2>
      <span class="bo-tools__meta">4 projects &middot; all Go &middot; all open source</span>
    </div>
    <div class="bo-tools__grid">
      <ToolCard
        toolName="tracker"
        desc="Track deployments, operations, drift and incidents across your platforms. REST API and web UI included."
        stack="Go · MongoDB"
        version="v0.9.3"
        license="MIT"
        status="stable"
        docsHref="https://docs.bananaops.tech/tracker"
        repoHref="https://github.com/BananaOps/tracker"
      />
      <ToolCard
        toolName="cloudoff"
        desc="Shuts EC2 instances down at night. Uptime and downtime windows are read straight from instance tags — inspired by kube-downscaler."
        stack="Go · AWS EC2"
        version="v0.4.2"
        license="MIT"
        status="beta"
        docsHref="https://docs.bananaops.tech/cloudoff"
        repoHref="https://github.com/BananaOps/cloudoff"
      />
      <ToolCard
        toolName="skopeo"
        desc="Synchronises Helm charts between registries — Nexus, ECR and Scaleway Registry."
        stack="Go · OCI · Helm"
        version="v0.3.0"
        license="MIT"
        status="beta"
        docsHref="https://docs.bananaops.tech/skopeo"
        repoHref="https://github.com/BananaOps/skopeo"
      />
      <ToolCard
        toolName="homer-k8s"
        desc="Kubernetes operator that generates a dynamic Homer dashboard: one home page for every tool and link in your cluster."
        stack="Go · Operator SDK"
        version="v0.2.1"
        license="MIT"
        status="WIP"
        docsHref="https://docs.bananaops.tech/homer-k8s"
        repoHref="https://github.com/BananaOps/homer-k8s"
      />
    </div>
  </section>

  <!-- Who we are -->
  <section class="bo-who">
    <div class="bo-who__inner">
      <h2 class="bo-who__title">Who we are</h2>
      <div class="bo-who__body">
        <p class="bo-who__text">
          BananaOps is an open community of engineers specialised in cloud infrastructure,
          scaling and microservices. We build the tools we need to run platforms, in the open,
          and we document them properly.
        </p>
        <a
          href="https://github.com/BananaOps"
          class="bo-who__link"
          target="_blank"
          rel="noopener noreferrer"
        >
          Contribute on GitHub &#8599;
        </a>
      </div>
    </div>
  </section>

</div>

<style>
  /* Reset Starlight hero */
  :global(.sl-markdown-content > .hero) {
    display: none !important;
  }
  :global(.content-panel) {
    padding: 0 !important;
    max-width: 100% !important;
  }
  :global(.sl-markdown-content) {
    max-width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  /* Home wrapper */
  .bo-home {
    width: 100%;
    background: #EDE6D8;
  }

  /* Hero */
  .bo-hero {
    display: grid;
    grid-template-columns: 1fr 400px;
    align-items: center;
    gap: 64px;
    padding: 88px 96px 76px;
    background: #EDE6D8;
  }
  .bo-hero__content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .bo-hero__eyebrow {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #5C6B85;
  }
  .bo-hero__title {
    margin: 0;
    font-family: "Sora", "Inter", system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 64px;
    line-height: 1.05;
    color: #10264A;
    max-width: 16ch;
    text-wrap: balance;
  }
  .bo-hero__sub {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: #5C6B85;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .bo-hero__cta {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 8px;
  }
  .bo-btn-primary {
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #10264A;
    background: #FFC83D;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 10px;
    box-shadow: 0 3px 0 #E5A521;
    transition: background 0.2s, box-shadow 0.2s;
    display: inline-block;
  }
  .bo-btn-primary:hover {
    background: #E5A521;
    box-shadow: 0 3px 0 #10264A;
  }
  .bo-btn-outline {
    font-family: "Inter", system-ui, sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: #10264A;
    text-decoration: none;
    padding: 14px 22px;
    border-radius: 10px;
    border: 1.5px solid rgba(16, 38, 74, 0.25);
    transition: border-color 0.2s;
    display: inline-block;
  }
  .bo-btn-outline:hover {
    border-color: #10264A;
  }
  .bo-hero__mascot {
    justify-self: end;
  }

  /* Tools */
  .bo-tools {
    padding: 8px 96px 88px;
    background: #EDE6D8;
  }
  .bo-tools__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(16, 38, 74, 0.14);
    margin-bottom: 24px;
  }
  .bo-tools__title {
    font-family: "Sora", "Inter", system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 30px;
    color: #10264A;
    margin: 0;
  }
  .bo-tools__meta {
    font-size: 14px;
    font-weight: 500;
    color: #5C6B85;
  }
  .bo-tools__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  /* Who we are */
  .bo-who {
    background: #10264A;
    padding: 72px 96px;
  }
  .bo-who__inner {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 64px;
    align-items: start;
  }
  .bo-who__title {
    margin: 0;
    font-family: "Sora", "Inter", system-ui, sans-serif;
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: 32px;
    line-height: 1.15;
    color: #EDE6D8;
  }
  .bo-who__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .bo-who__text {
    margin: 0;
    font-size: 19px;
    line-height: 1.65;
    color: #EDE6D8;
    max-width: 62ch;
    text-wrap: pretty;
  }
  .bo-who__link {
    font-weight: 600;
    font-size: 15px;
    color: #FFC83D;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(255, 200, 61, 0.4);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: border-color 0.2s;
  }
  .bo-who__link:hover {
    border-bottom-color: #FFC83D;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .bo-hero {
      grid-template-columns: 1fr;
      padding: 60px 40px 48px;
      gap: 32px;
    }
    .bo-hero__mascot {
      justify-self: center;
      width: 200px;
      height: auto;
    }
    .bo-hero__title {
      font-size: 48px;
    }
    .bo-tools {
      padding: 8px 40px 64px;
    }
    .bo-who {
      padding: 48px 40px;
    }
    .bo-who__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 768px) {
    .bo-hero {
      padding: 32px 20px 28px;
      gap: 20px;
    }
    .bo-hero__title {
      font-size: 36px;
      line-height: 1.08;
    }
    .bo-hero__sub {
      font-size: 16px;
    }
    .bo-hero__cta {
      flex-direction: column;
      align-items: stretch;
    }
    .bo-hero__cta a {
      text-align: center;
    }
    .bo-hero__mascot {
      width: 150px;
      height: auto;
    }
    .bo-tools {
      padding: 8px 20px 40px;
    }
    .bo-tools__grid {
      grid-template-columns: 1fr;
    }
    .bo-who {
      padding: 36px 20px;
    }
  }
</style>
